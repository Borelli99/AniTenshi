<?xml version="1.0" encoding="utf-8"?>
<!-- AniTenshi: themed (monochrome) launcher icon -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateY="-0.7">
        <!-- Back half of the halo, behind the A -->
        <path
            android:pathData="M39,52 A15,4.6 0,0 1,69 52"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.6" />
        <!-- The A, without crossbar -->
        <path
            android:pathData="M38,77 L54,33 L70,77"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Front half of the halo, over the A: it becomes the crossbar -->
        <path
            android:pathData="M39,52 A15,4.6 0,0 0,69 52"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.6"
            android:strokeLineCap="round" />
    </group>
</vector>
