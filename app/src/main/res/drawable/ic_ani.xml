<?xml version="1.0" encoding="utf-8"?>
<!-- AniTenshi logo, single colour: notification icon and "More" header (tinted at runtime) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="56"
    android:viewportHeight="56">
    <group
        android:translateX="-26"
        android:translateY="-27">
        <!-- Back half of the halo, behind the A -->
        <path
            android:pathData="M39,52 A15,4.6 0,0 1,69 52"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.6" />
        <!-- The A, without crossbar -->
        <path
            android:pathData="M38,77 L54,33 L70,77"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Front half of the halo, over the A: it becomes the crossbar -->
        <path
            android:pathData="M39,52 A15,4.6 0,0 0,69 52"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.6"
            android:strokeLineCap="round" />
    </group>
</vector>
