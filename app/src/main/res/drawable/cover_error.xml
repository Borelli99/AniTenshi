<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <item>
        <color android:color="@color/cover_placeholder" />
    </item>

    <item
        android:top="40dp"
        android:bottom="40dp"
        android:left="40dp"
        android:right="40dp">
        <!-- Opaque paths under one alpha (that of cover_placeholder), so the A and its horns don't add up where they overlap -->
