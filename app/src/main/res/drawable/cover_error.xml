            android:width="40dp"
            android:height="40dp"
            android:alpha="0.12"
            android:viewportWidth="56"
            android:viewportHeight="56">
            <!-- AniTenshi: the A with the devil horns of AniTenshiMark, in one quiet tone -->
            <group
                android:translateX="-26"
                android:translateY="-27">
                <path
                    android:fillColor="#888888"
                    android:pathData="M47.6,47.5C41.5,46.8 38.6,41.5 39.4,35.5C39.8,32.6 40.9,30.2 42.6,28.2C42.5,33.2 45.2,38.4 49.9,40.8Z" />
                <group
                    android:pivotX="54"
                    android:scaleX="-1">
                    <path
                        android:fillColor="#888888"
                        android:pathData="M47.6,47.5C41.5,46.8 38.6,41.5 39.4,35.5C39.8,32.6 40.9,30.2 42.6,28.2C42.5,33.2 45.2,38.4 49.9,40.8Z" />
                </group>
                <path
                    android:pathData="M38,77L54,33L70,77"
                    android:strokeColor="#888888"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:strokeWidth="7.5" />
            </group>
        </vector>
    </item>

</layer-list>
